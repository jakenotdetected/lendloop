{
  "id": "LendLoopOverdue1",
  "name": "LendLoop – Overdue reminders",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LendLoopErrors01",
    "saveManualExecutions": true
  },
  "nodes": [
    {
      "id": "LendLoopOverdue1-01",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "name": "Every day at 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "id": "LendLoopOverdue1-02",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nfunction sign(body) {\n  const secret = $env.LENDLOOP_CALLBACK_SECRET;\n  if (!secret) throw new Error('LENDLOOP_CALLBACK_SECRET is not set');\n  const t = Math.floor(Date.now() / 1000);\n  const v1 = crypto.createHmac('sha256', secret).update(t + '.' + body).digest('hex');\n  return 't=' + t + ',v1=' + v1;\n}\nconst body = JSON.stringify({});\nreturn [{ json: { body, signature: sign(body) } }];"
      },
      "name": "Sign overdue query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ]
    },
    {
      "id": "LendLoopOverdue1-03",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    },
    {
      "id": "LendLoopOverdue1-04",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { loans } = $input.first().json;\nif (!Array.isArray(loans)) throw new Error('Unexpected response from Convex: loans is not an array');\nreturn loans.map((loan) => ({ json: loan }));"
      },
      "name": "One item per loan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "id": "LendLoopOverdue1-05",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(({ json: loan }) => {\n  try {\n    const name = loan.borrower.firstName || 'there';\n    const days = loan.daysOverdue === 1 ? '1 day' : loan.daysOverdue + ' days';\n    const text = 'Hi ' + name + ', the ' + loan.toolName + ' you borrowed was due back on ' + loan.endDate + ' (' + days + ' ago). Please return it or contact the lender.';\n    console.log('[LendLoop] reminder ' + loan.borrower.email + ' | ' + text);\n    return { json: { loanId: loan.loanId, idempotencyKey: loan.idempotencyKey, status: 'sent', message: 'Reminder sent (' + days + ' overdue)' } };\n  } catch (err) {\n    return { json: { loanId: loan.loanId, idempotencyKey: loan.idempotencyKey, status: 'failed', message: String(err && err.message || err) } };\n  }\n});"
      },
      "name": "Send reminder (mock)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "id": "LendLoopOverdue1-06",
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const crypto = require('crypto');\nfunction sign(body) {\n  const secret = $env.LENDLOOP_CALLBACK_SECRET;\n  if (!secret) throw new Error('LENDLOOP_CALLBACK_SECRET is not set');\n  const t = Math.floor(Date.now() / 1000);\n  const v1 = crypto.createHmac('sha256', secret).update(t + '.' + body).digest('hex');\n  return 't=' + t + ',v1=' + v1;\n}\nreturn $input.all().map(({ json: r }) => {\n  const body = JSON.stringify({ loanId: r.loanId, idempotencyKey: r.idempotencyKey, status: r.status, message: r.message });\n  return { json: { body, signature: sign(body) } };\n});"
      },
      "name": "Sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "id": "LendLoopOverdue1-07",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "name": "Record reminder in Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        300
      ],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every day at 09:00": {
      "main": [
        [
          {
            "node": "Sign overdue query",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign overdue query": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per loan": {
      "main": [
        [
          {
            "node": "Send reminder (mock)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder (mock)": {
      "main": [
        [
          {
            "node": "Sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign write-back": {
      "main": [
        [
          {
            "node": "Record reminder in Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
